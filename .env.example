# Copia este fichero a .env para desarrollo local (bun run dev lo carga si existe).
# Genera las claves de 32 bytes con: openssl rand -base64 32

# General
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ALLOWED_FROM_DOMAINS=example.com

# Autenticación y límites de petición
API_KEY_PEPPER=
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_BODY_BYTES=15728640
MAX_ATTACHMENTS_BYTES=10485760

# Infraestructura (puertos publicados por docker-compose.yml)
DATABASE_URL=postgres://mail:mail@localhost:55432/mail
REDIS_URL=redis://localhost:56379

# Proveedor para transport=api: mailgun | ses (vacío = transporte api deshabilitado)
MAIL_API_PROVIDER=

# SMTP
SMTP_CREDENTIALS_ENCRYPTION_KEY=
SMTP_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
SMTP_ALLOWED_HOSTS=
SMTP_ALLOWED_PRIVATE_HOSTS=mailpit,localhost
SMTP_POOL_MAX_CONNECTIONS=5
SMTP_RATE_LIMIT_PER_SECOND=5
SMTP_TRANSPORT_CACHE_TTL_MS=300000
SMTP_TRANSPORT_CACHE_MAX=50
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=eu
MAILGUN_WEBHOOK_SIGNING_KEY=

# SES
AWS_REGION=eu-west-1
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARNS=

# Worker
WORKER_QUEUES=api,smtp
WORKER_HEALTH_PORT=3001
WORKER_API_CONCURRENCY=10
WORKER_API_RATE_LIMIT_PER_SECOND=10
WORKER_SMTP_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=30000

# Mantenimiento
SWEEP_INTERVAL_MS=60000
STALE_PENDING_AFTER_MS=600000
PENDING_MAX_AGE_MS=86400000
PAYLOAD_RETENTION_DAYS=7
EVENTS_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=365
